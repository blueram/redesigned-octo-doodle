[{"id":1,"chosung":"ㅅㅂㄱ","answer":"소방관","hint1":"위험한 현장에 보호 장비를 착용하고 들어간다","hint2":"화재 진압과 구조 활동을 한다","hint3":"불을 끄고 사람을 구조하는 직업","category":"직업","difficulty":"쉬움"},{"id":2,"chosung":"ㅅㅋ","answer":"스키","hint1":"두 개의 긴 장비를 발에 착용한다","hint2":"눈 덮인 경사면을 내려온다","hint3":"설원에서 미끄러져 내려오는 겨울 스포츠","category":"스포츠","difficulty":"쉬움"},{"id":3,"chosung":"ㄷㄹㅁ","answer":"다리미","hint1":"열을 이용해 섬유 모양을 편다","hint2":"옷의 주름을 없앨 때 쓴다","hint3":"뜨거운 바닥으로 옷을 펴는 가전","category":"가전","difficulty":"쉬움"},{"id":4,"chosung":"ㅎㄸ","answer":"호떡","hint1":"겨울 길거리에서 자주 만난다","hint2":"안에 설탕과 견과류가 들어간다","hint3":"납작하게 구워 먹는 달콤한 간식","category":"음식","difficulty":"쉬움"},{"id":5,"chosung":"ㅎㄷㅂㄷ","answer":"횡단보도","hint1":"신호에 맞춰 건너야 한다","hint2":"도로에 흰 줄이 여러 개 그어져 있다","hint3":"보행자가 차도를 건너는 곳","category":"교통","difficulty":"쉬움"},{"id":6,"chosung":"ㄷㅁㅇ","answer":"동물원","hint1":"동물의 습성에 맞는 공간이 필요하다","hint2":"여러 지역의 동물을 한곳에서 볼 수 있다","hint3":"사자와 코끼리 등을 볼 수 있는 장소","category":"장소","difficulty":"쉬움"},{"id":7,"chosung":"ㅈㅅㄱ","answer":"제습기","hint1":"물통에 물이 모인다","hint2":"습한 공기에서 수분을 제거한다","hint3":"장마철 실내 습기를 줄이는 가전","category":"가전","difficulty":"쉬움"},{"id":8,"chosung":"ㅈㅈㄹㅇㅈ","answer":"전자레인지","hint1":"금속 용기는 주의해야 한다","hint2":"짧은 시간에 음식을 데울 수 있다","hint3":"음식을 빠르게 데우는 주방가전","category":"가전","difficulty":"쉬움"},{"id":9,"chosung":"ㄷㅍㄴㅁ","answer":"단풍나무","hint1":"계절이 바뀌면 잎 색이 선명해진다","hint2":"가을 산을 붉게 물들인다","hint3":"손바닥 모양 잎이 붉게 변하는 나무","category":"자연","difficulty":"쉬움"},{"id":10,"chosung":"ㅁㅇㄱ","answer":"망원경","hint1":"멀리서 오는 빛을 모아 관찰한다","hint2":"천체나 먼 풍경을 크게 본다","hint3":"별과 달을 관찰할 때 쓰는 기구","category":"상식","difficulty":"쉬움"},{"id":11,"chosung":"ㄴㅇ","answer":"뉴욕","hint1":"다양한 문화와 높은 빌딩이 모여 있다","hint2":"자유의 여신상과 타임스스퀘어가 있다","hint3":"미국의 대표적인 세계 도시","category":"도시","difficulty":"쉬움"},{"id":12,"chosung":"ㅈㄱ","answer":"중국","hint1":"인구와 면적이 매우 큰 나라다","hint2":"만리장성이 있다","hint3":"수도가 베이징인 아시아 국가","category":"나라","difficulty":"쉬움"},{"id":13,"chosung":"ㄷㄱ","answer":"동굴","hint1":"햇빛이 거의 들지 않는 곳이 많다","hint2":"바위나 지하에 빈 공간이 생긴다","hint3":"산이나 땅속에 생긴 깊