":"육상에서 가장 빠른 동물","category":"동물","difficulty":"쉬움"},{"id":180,"chosung":"ㅂㅅㅈㄹㅈ","answer":"버스정류장","hint1":"노선 번호와 도착 정보를 확인한다","hint2":"버스를 기다리는 곳이다","hint3":"길가에서 버스를 타고 내리는 장소","category":"교통","difficulty":"쉬움"},{"id":181,"chosung":"ㅂㅅㄱ","answer":"비상구","hint1":"평소 물건으로 막아두면 안 된다","hint2":"위급할 때 건물 밖으로 빠져나가는 길이다","hint3":"초록색 사람이 그려진 탈출구","category":"상식","difficulty":"쉬움"},{"id":182,"chosung":"ㄴㅂ","answer":"농부","hint1":"계절과 날씨의 영향을 많이 받는다","hint2":"논밭에서 곡식과 채소를 기른다","hint3":"농작물을 재배하는 직업","category":"직업","difficulty":"쉬움"},{"id":183,"chosung":"ㄱㅈㅅ","answer":"공작새","hint1":"수컷의 장식 깃털이 매우 화려하다","hint2":"꼬리를 부채처럼 펼친다","hint3":"눈 모양 무늬의 긴 꼬리를 가진 새","category":"동물","difficulty":"쉬움"},{"id":184,"chosung":"ㅅㅍㄱㅌ","answer":"스파게티","hint1":"긴 면을 포크에 돌돌 말아 먹는다","hint2":"토마토나 크림 소스를 많이 쓴다","hint3":"이탈리아식 긴 면 요리","category":"음식","difficulty":"쉬움"},{"id":185,"chosung":"ㅈㅈㄷ","answer":"제주도","hint1":"화산 활동으로 만들어진 섬이다","hint2":"한라산과 돌하르방이 유명하다","hint3":"우리나라 남쪽의 대표 관광 섬","category":"도시","difficulty":"쉬움"},{"id":186,"chosung":"ㅌㄱ","answer":"탁구","hint1":"공이 매우 가볍고 작다","hint2":"작은 라켓으로 테이블 위에서 경기한다","hint3":"탁자와 네트를 사용하는 실내 스포츠","category":"스포츠","difficulty":"쉬움"},{"id":187,"chosung":"ㄱㅊㅉㄱ","answer":"김치찌개","hint1":"익은 발효 채소가 주재료다","hint2":"돼지고기나 참치를 넣기도 한다","hint3":"김치를 넣어 얼큰하게 끓인 찌개","category":"음식","difficulty":"쉬움"},{"id":188,"chosung":"ㄱㅅㄱ","answer":"가습기","hint1":"물통을 깨끗하게 관리해야 한다","hint2":"건조한 실내에 수분을 공급한다","hint3":"공기 중 습도를 높이는 가전","category":"가전","difficulty":"쉬움"},{"id":189,"chosung":"ㅎㅂㄹㄱ","answer":"해바라기","hint1":"씨앗에서 기름을 얻기도 한다","hint2":"큰 꽃이 해가 있는 방향을 향한다","hint3":"노란 꽃잎과 검은 중심이 큰 꽃","category":"자연","difficulty":"쉬움"},{"id":190,"chosung":"ㅇㄹㄹ","answer":"오로라","hint1":"태양에서 온 입자가 대기와 반응해 나타난다","hint2":"극지방 밤하늘에서 자주 관찰된다","hint3":"북쪽 하늘에 춤추는 듯한 빛의 커튼","category":"자연","difficulty":"보통"},{"id":191,"chosung":"ㄷㄴㅁ","answer":"대나무","hint1":"속이 비고 마디가 있다","hint2":"성장 속도가 매우 빠른 종류가 있다","hint3":"판다가 먹는 키 큰 식물","category":"자연","difficulty":"쉬움"},{"id":192,"chosung":"ㅂㅅ","answer":"부산","hin