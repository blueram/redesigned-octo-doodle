ficulty":"쉬움"},{"id":78,"chosung":"ㅇㄴㅇㅅ","answer":"아나운서","hint1":"정확한 발음과 전달력이 필요하다","hint2":"뉴스나 방송 프로그램을 진행한다","hint3":"방송에서 내용을 읽고 진행하는 직업","category":"직업","difficulty":"쉬움"},{"id":79,"chosung":"ㅌㅂㄱㅅ","answer":"택배기사","hint1":"주소를 확인해 이동 경로를 정한다","hint2":"상자와 물건을 집이나 회사에 전달한다","hint3":"주문한 물품을 배송하는 직업","category":"직업","difficulty":"쉬움"},{"id":80,"chosung":"ㅂㅇㅇ","answer":"부엉이","hint1":"소리 없이 날아 먹이를 잡는다","hint2":"밤에 활동하고 눈이 크다","hint3":"밤을 상징하는 큰 눈의 새","category":"동물","difficulty":"쉬움"},{"id":81,"chosung":"ㅂㅁㅊㄱ","answer":"보물찾기","hint1":"단서의 의미를 해석해야 한다","hint2":"숨겨진 물건을 먼저 찾는 놀이","hint3":"힌트를 따라 보물을 찾는 게임","category":"놀이","difficulty":"쉬움"},{"id":82,"chosung":"ㅋㅇㅂㅋ","answer":"케이블카","hint1":"공중의 줄에 매달려 이동한다","hint2":"산이나 높은 곳을 오르내릴 때 이용한다","hint3":"케이블을 따라 움직이는 작은 객차","category":"교통","difficulty":"보통"},{"id":83,"chosung":"ㅍㅇㅈ","answer":"편의점","hint1":"대부분 작은 규모로 운영된다","hint2":"간식과 음료, 생활용품을 쉽게 살 수 있다","hint3":"늦은 시간에도 이용하기 쉬운 작은 가게","category":"장소","difficulty":"쉬움"},{"id":84,"chosung":"ㅂㄹㅈ","answer":"브라질","hint1":"남아메리카에서 가장 큰 나라다","hint2":"축구와 삼바로 유명하다","hint3":"아마존과 리우데자네이루가 있는 나라","category":"나라","difficulty":"쉬움"},{"id":85,"chosung":"ㅎㅁㄱ","answer":"현미경","hint1":"렌즈로 아주 작은 대상을 확대한다","hint2":"세포나 미생물을 관찰할 때 쓴다","hint3":"눈에 잘 안 보이는 작은 것을 크게 보는 기구","category":"상식","difficulty":"쉬움"},{"id":86,"chosung":"ㄱㄹ","answer":"기린","hint1":"높은 곳의 잎을 먹기 유리하다","hint2":"목과 다리가 매우 길다","hint3":"세상에서 키가 가장 큰 육상동물","category":"동물","difficulty":"쉬움"},{"id":87,"chosung":"ㄴㅌ","answer":"낙타","hint1":"몸속 수분을 아끼는 능력이 뛰어나다","hint2":"등에 혹이 있다","hint3":"사막을 이동할 때 이용하는 동물","category":"동물","difficulty":"쉬움"},{"id":88,"chosung":"ㅅㅂㅅ","answer":"소방서","hint1":"긴급 상황에 빠르게 출동한다","hint2":"소방차와 구급차가 대기한다","hint3":"불을 끄는 소방관이 근무하는 곳","category":"장소","difficulty":"쉬움"},{"id":89,"chosung":"ㅅㄷㅇㅊ","answer":"샌드위치","hint1":"재료가 두 겹 사이에 들어간다","hint2":"간단한 아침이나 도시락으로 먹는다","hint3":"빵 사이에 햄과 채소를 넣은 음식","category":"음식","difficulty":"쉬움"},{"id":90,"chosung":"ㄴㅊㅂ","answer":"나침반","hint1":"지구의 자기장을 이용한다","hint2":"바늘이 남북 방향을 알려준다","hint3":"방향을 찾을 때 쓰는 도구","category":"상식","difficulty":"쉬움"},{"id":91,"chosung":"ㅅㅎㅊ","answer":"산호초","hint1":"많은 바다 생물의 보금자리다","hint2":"따뜻하고 맑은 바다에 발달한다","hint3":"산호가 모여 만든 바닷속 지형","category":"자연","difficulty":"보통"},{"id":92,"chosung":"ㄱㅂ","answer":"김밥","hint1":"여러 재료가 한 줄 안에 모인다","hint2":"소풍이나 간단한 식사로 자주 먹는다","hint3":"김에 밥과 재료를 말아 썬 음식","category":"음식","difficulty":"쉬움"},{"id":93,"chosung":"ㅁㅇㅋ","answer":"미어캣","hint1":"무리 중 일부가 주변을 감시한다","hint2":"두 발로 서서 멀리 바라본다","hint3":"사막에서 망을 보는 모습으로 유명한 동물","category":"동물","difficulty":"보통"},{"id":94,"chosung":"ㄷㅋ","answer":"도쿄","hint1":"인구가 매우 많은 대도시다","hint2":"도쿄타워와 시부야가 유명하다","hint3":"일본의 수도","category":"도시","difficulty":"쉬움"},{"id":95,"chosung":"ㅍㅍ","answer":"폭포","hint1":"물의 낙차가 큰 지형이다","hint2":"강물이 절벽 아래로 떨어진다","hint3":"높은 곳에서 물이 쏟아지는 자연경관","category":"자연","difficulty":"쉬움"},{"id":96,"chosung":"ㅁㅅㄱ","answer":"믹서기","hint1":"날카로운 칼날이 빠르게 회전한다","hint2":"과일이나 채소를 곱게 간다","hint3":"주스나 스무디를 만드는 주방가전","category":"가전","difficulty":"쉬움"},{"id":97,"chosung":"ㅎㅁ","answer":"하마","hint1":"낮에는 물속에서 몸을 식힌다","hint2":"입이 매우 크고 몸집이 무겁다","hint3":"아프리카 강에 사는 큰 동물","category":"동물","difficulty":"쉬움"},{"id":98,"chosung":"ㄸㅂㅇ","answer":"떡볶이","hint1":"쌀이나 밀로 만든 재료를 양념에 익힌다","hint2":"분식집에서 어묵과 함께 많이 먹는다","hint3":"매콤한 양념에 떡을 볶은 음식","category":"음식","difficulty":"쉬움"},{"id":99,"chosung":"ㄱㅅ","answer":"교사","hint1":"학생의 이해 정도를 살핀다","hint2":"학교에서 수업하고 생활을 지도한다","hint3":"학생을 가르치는 직업","category":"직업","difficulty":"쉬움"},{"id":100,"chosung":"ㅍㄹㄱㄹㅁ","answer":"프로그래머","hint1":"논리와 명령어로 기능을 만든다","hint2":"컴퓨터 프로그램과 앱을 개발한다","hint3":"코드를 작성하는 직업","category":"직업","difficulty":"보통"},{"id":101,"chosung":"ㅇㄱ","answer":"야구","hint1":"공격과 수비를 번갈아 한다","hint2":"배트로 공을 치고 베이스를 돈다","hint3":"투수와 타자가 대결하는 스포츠","category":"스포츠","difficulty":"쉬움"},{"id":102,"chosung":"ㅇㄴㅇ","answer":"윷놀이","hint1":"네 개의 막대를 던진다","hint2":"도와 개, 걸, 윷, 모가 나온다","hint3":"설날에 많이 하는 전통 보드놀이","category":"놀이","difficulty":"쉬움"},{"id":103,"chosung":"ㄷㄱㄹ","answer":"돌고래","hint1":"소리로 주변을 파악한다","hint2":"머리가 좋고 무리를 지어 산다","hint3":"바다에서 점프하는 영리한 포유류","category":"동물","difficulty":"쉬움"},{"id":104,"chosung":"ㄱㅊㅅ","answer":"경찰서","hint1":"지역의 치안 업무를 담당한다","hint2":"사건 신고나 분실물 문의를 할 수 있다","hint3":"경찰이 근무하는 기관","category":"장소","difficulty":"쉬움"},{"id":105,"chosung":"ㅅㅇㅈ","answer":"선인장","hint1":"잎이 가시로 변해 수분 손실을 줄인다","hint2":"건조한 환경에 강하다","hint3":"사막에서 자라는 가시 많은 식물","category":"자연","difficulty":"쉬움"},{"id":106,"chosung":"ㅍㅇㅊㄱ","answer":"팽이치기","hint1":"회전이 오래 유지되도록 해야 한다","hint2":"줄로 감은 물체를 바닥에 던진다","hint3":"빙글빙글 도는 전통 장난감 놀이","category":"놀이","difficulty":"보통"},{"id":107,"chosung":"ㅊㅂ","answer":"초밥","hint1":"식초로 간한 밥을 사용한다","hint2":"생선이나 해산물을 밥 위에 올린다","hint3":"작은 밥 위에 회를 얹은 일본 음식","category":"음식","difficulty":"쉬움"},{"id":108,"chosung":"ㄱㅇㅂㅇㅂ","answer":"가위바위보","hint1":"세 가지 손 모양이 서로 이기고 진다","hint2":"한 번에 승부를 정할 때 자주 사용한다","hint3":"가위와 바위, 보를 손으로 내는 놀이","category":"놀이","difficulty":"쉬움"},{"id":109,"chosung":"ㅍㅈㅁㅊㄱ","answer":"퍼즐맞추기","hint1":"모양과 그림의 연결을 관찰한다","hint2":"조각을 올바른 자리에 끼운다","hint3":"여러 조각을 모아 하나의 그림을 만드는 놀이","category":"놀이","difficulty":"쉬움"},{"id":110,"chosung":"ㅎㄹㅋㅌ","answer":"헬리콥터","hint1":"공중에서 제자리 비행이 가능하다","hint2":"위쪽의 큰 회전날개로 난다","hint3":"프로펠러가 위에서 도는 항공기","category":"교통","difficulty":"보통"},{"id":111,"chosung":"ㅁㄷㄹ","answer":"민들레","hint1":"씨앗이 바람을 타고 멀리 간다","hint2":"노란 꽃이 지고 하얀 솜털이 생긴다","hint3":"불면 씨앗이 날아가는 들꽃","category":"자연","difficulty":"쉬움"},{"id":112,"chosung":"ㅇㅂ","answer":"일본","hint1":"여러 섬으로 이루어진 나라다","hint2":"수도는 도쿄다","hint3":"한국과 바다를 사이에 둔 동쪽 나라","category":"나라","difficulty":"쉬움"},{"id":113,"chosung":"ㅊㅈㅂㄱ","answer":"치즈버거","hint1":"빵 사이에 여러 재료가 층을 이룬다","hint2":"고기 패티 위에 유제품 한 장을 올린다","hint3":"치즈가 들어간 햄버거","category":"음식","difficulty":"쉬움"},{"id":114,"chosung":"ㅇㅌㅂㅇ","answer":"오토바이","hint1":"차체가 작고 균형이 필요하다","hint2":"엔진이 달린 두 바퀴 차량이다","hint3":"도로를 달리는 소형 이륜차","category":"교통","difficulty":"쉬움"},{"id":115,"chosung":"ㄱㅎㅅ","answer":"간호사","hint1":"환자의 상태를 가까이에서 살핀다","hint2":"의료진과 함께 치료와 간호를 한다","hint3":"병원에서 환자를 돌보는 직업","category":"직업","difficulty":"쉬움"},{"id":116,"chosung":"ㅅㅇㅅ","answer":"수의사","hint1":"사람이 아닌 환자를 진료한다","hint2":"반려동물과 가축을 치료한다","hint3":"동물을 치료하는 의사","category":"직업","difficulty":"쉬움"},{"id":117,"chosung":"ㅅㅂㄲㅈ","answer":"숨바꼭질","hint1":"한 사람은 눈을 감고 숫자를 센다","hint2":"숨은 사람을 찾아내는 놀이","hint3":"술래가 숨은 친구를 찾는 놀이","category":"놀이","difficulty":"쉬움"},{"id":118,"chosung":"ㄱㅊㅇ","answer":"기차역","hint1":"승강장과 선로가 있다","hint2":"열차표를 확인하고 기차를 탄다","hint3":"기차가 출발하고 도착하는 장소","category":"교통","difficulty":"쉬움"},{"id":119,"chosung":"ㅅㅌㄱ","answer":"세탁기","hint1":"물을 받아 회전하는 방식이 많다","hint2":"세탁과 헹굼, 탈수를 한다","hint3":"옷을 자동으로 빠는 가전제품","category":"가전","difficulty":"쉬움"},{"id":120,"chosung":"ㅋㅇㄹ","answer":"코알라","hint1":"하루 대부분을 쉬며 보낸다","hint2":"유칼립투스 잎을 주로 먹는다","hint3":"호주 나무 위에 사는 회색 동물","category":"동물","difficulty":"쉬움"},{"id":121,"chosung":"ㅁㅈㄱ","answer":"무지개","hint1":"관찰자의 위치에 따라 보이는 자리가 달라진다","hint2":"비가 그친 뒤 햇빛이 비칠 때 나타난다","hint3":"하늘에 여러 색의 활 모양으로 보이는 현상","category":"자연","difficulty":"쉬움"},{"id":122,"chosung":"ㅋㄱㄹ","answer":"캥거루","hint1":"두 발로 뛰어 이동한다","hint2":"배에 새끼를 넣는 주머니가 있다","hint3":"호주를 대표하는 주머니 동물","category":"동물","difficulty":"쉬움"},{"id":123,"chosung":"ㅇㅅ","answer":"약사","hint1":"약의 복용 방법과 주의사항을 설명한다","hint2":"처방전에 따라 약을 조제한다","hint3":"약국에서 약을 다루는 직업","category":"직업","difficulty":"쉬움"},{"id":124,"chosung":"ㅇㄱ","answer":"양궁","hint1":"호흡과 자세를 일정하게 유지해야 한다","hint2":"활로 화살을 과녁에 쏜다","hint3":"과녁의 중심을 맞히는 활쏘기 종목","category":"스포츠","difficulty":"쉬움"},{"id":125,"chosung":"ㅈㅁ","answer":"장미","hint1":"색에 따라 상징하는 의미가 다르다","hint2":"줄기에 가시가 있다","hint3":"사랑을 상징하는 향기로운 꽃","category":"자연","difficulty":"쉬움"},{"id":126,"chosung":"ㄱㄱㅊ","answer":"구급차","hint1":"응급 장비와 들것을 싣는다","hint2":"환자를 병원으로 빠르게 옮긴다","hint3":"사이렌을 울리며 출동하는 응급 차량","category":"교통","difficulty":"쉬움"},{"id":127,"chosung":"ㅂㅎ","answer":"빙하","hint1":"오랜 시간 쌓인 눈이 압축되어 만들어진다","hint2":"천천히 흐르는 거대한 얼음 덩어리다","hint3":"극지방이나 높은 산에 있는 거대한 얼음","category":"자연","difficulty":"보통"},{"id":128,"chosung":"ㅁㅊ","answer":"망치","hint1":"손잡이 끝에 무거운 머리가 달려 있다","hint2":"못을 박거나 물체를 두드린다","hint3":"못을 박을 때 사용하는 공구","category":"생활용품","difficulty":"쉬움"},{"id":129,"chosung":"ㅂㄱ","answer":"베개","hint1":"높이와 단단함이 잠에 영향을 준다","hint2":"침대나 이불 위에 놓는다","hint3":"잠잘 때 머리를 받치는 물건","category":"생활용품","difficulty":"쉬움"},{"id":130,"chosung":"ㅋㅁㄹㅇ","answer":"카멜레온","hint1":"주변 환경에 따라 몸색이 달라질 수 있다","hint2":"혀를 길게 뻗어 먹이를 잡는다","hint3":"색을 바꾸는 것으로 유명한 도마뱀","category":"동물","difficulty":"보통"},{"id":131,"chosung":"ㅈㄱㅂㅅ","answer":"전기밥솥","hint1":"압력을 사용하는 제품도 있다","hint2":"쌀과 물을 넣고 버튼을 누른다","hint3":"밥을 자동으로 짓고 보온하는 가전","category":"가전","difficulty":"쉬움"},{"id":132,"chosung":"ㅈㅊ","answer":"잡채","hint1":"잔칫상에 자주 올라간다","hint2":"당면과 채소를 볶아 만든다","hint3":"투명한 면을 간장 양념에 볶은 음식","category":"음식","difficulty":"보통"},{"id":133,"chosung":"ㄹㅁ","answer":"로마","hint1":"고대 제국의 중심지였다","hint2":"콜로세움이 있는 도시다","hint3":"이탈리아의 수도","category":"도시","difficulty":"쉬움"},{"id":134,"chosung":"ㅂㄷㅁㅌ","answer":"배드민턴","hint1":"공 대신 깃털 모양 물체를 사용한다","hint2":"라켓으로 셔틀콕을 네트 너머로 친다","hint3":"셔틀콕을 주고받는 스포츠","category":"스포츠","difficulty":"쉬움"},{"id":135,"chosung":"ㅎㅈ","answer":"호주","hint1":"하나의 대륙을 중심으로 한 나라다","hint2":"캥거루와 코알라로 유명하다","hint3":"시드니가 유명한 남반구 국가","category":"나라","difficulty":"쉬움"},{"id":136,"chosung":"ㅂㄲ","answer":"벚꽃","hint1":"피는 기간이 짧아 아쉬움을 준다","hint2":"봄철 나무에 연분홍 꽃이 핀다","hint3":"봄 축제와 꽃길로 유명한 꽃","category":"자연","difficulty":"쉬움"},{"id":137,"chosung":"ㅅㅁ","answer":"사막","hint1":"낮과 밤의 기온 차가 매우 클 수 있다","hint2":"비가 매우 적게 내린다","hint3":"모래와 건조한 땅이 넓게 펼쳐진 지역","category":"자연","difficulty":"쉬움"},{"id":138,"chosung":"ㅌㄴㅅ","answer":"테니스","hint1":"점수가 15, 30, 40으로 올라간다","hint2":"라켓으로 공을 쳐 네트 너머로 보낸다","hint3":"작은 노란 공을 사용하는 라켓 스포츠","category":"스포츠","difficulty":"쉬움"},{"id":139,"chosung":"ㄷㄷㅈ","answer":"두더지","hint1":"빛이 적은 곳에서 생활한다","hint2":"땅속에 굴을 파며 산다","hint3":"앞발이 발달한 땅속 동물","category":"동물","difficulty":"보통"},{"id":140,"chosung":"ㅈㄱㅊㄱ","answer":"제기차기","hint1":"발의 안쪽이나 바깥쪽을 이용한다","hint2":"깃털 달린 물체를 떨어뜨리지 않고 찬다","hint3":"설날에 하는 전통 발놀이","category":"놀이","difficulty":"보통"},{"id":141,"chosung":"ㅇㅍ","answer":"와플","hint1":"반죽 표면에 네모난 무늬가 